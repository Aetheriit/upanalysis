# The domain name you purchased (e.g., example.com).
# This is used by Caddy to generate SSL certificates and by Next.js to know its URL.
DOMAIN_NAME=212.38.94.114.sslip.io

# Premium single-account access for the frontend.
# Set these in the deployment environment; do not commit production secrets.
PREMIUM_LOGIN_ID=rahul@admin
PREMIUM_LOGIN_PASSWORD=replace-with-your-password
AUTH_SECRET=replace-with-a-long-random-secret

# Optional external 2027 prediction service. When empty, the Prediction page
# uses the local /api/v1/predictions fallback engine.
NEXT_PUBLIC_PREDICTION_API_URL=

# Optional server-side atmosphere/evidence adapter. Leave empty to bypass the
# atmosphere layer and create statistical-only REVIEW snapshots.
PREDICTION_ATMOSPHERE_API_URL=
PREDICTION_ATMOSPHERE_API_KEY=
# Required only for authenticated POST /predictions/run and /evidence/scan.
PREDICTION_ADMIN_TOKEN=
PREDICTION_MC_DRAWS=20000
